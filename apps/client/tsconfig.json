{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/i18n": ["../../packages/i18n/src/index.ts"],
      "@repo/i18n/locales/*": ["../../packages/i18n/src/locales/*"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/ui": ["../../packages/ui/src/index.ts"],
      "@repo/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@repo/design-tokens/tailwind": ["../../packages/design-tokens/src/tailwind/preset.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
